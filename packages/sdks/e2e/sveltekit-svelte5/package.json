{
  "name": "@e2e/sveltekit-svelte5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "serve": "vite preview",
    "test": "SERVER_NAME=sveltekit-svelte5 yarn g:nx test:e2e @sdk/tests"
  },
  "dependencies": {
    "@builder.io/sdk-svelte5": "workspace:*",
    "@sdk/tests": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.1.1",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tslib": "^2.4.1",
    "typescript": "^5.1.6",
    "vite": "^7.3.8"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/.svelte-kit"
        ]
      }
    }
  }
}
